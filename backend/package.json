{
  "name": "dark-store-backend",
  "version": "1.0.0",
  "description": "Dark Store Management API",
  "main": "src/server.js",
  "scripts": {
    "postinstall": "prisma generate",
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev --name init",
    "db:push": "prisma db push",
    "db:ensure-customers": "prisma db execute --file prisma/sql/ensure_customers_table.sql",
    "db:seed": "node src/seeders/index.js",
    "db:seed-customers": "node src/seeders/customers.seeder.js",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset",
    "test:pickup-picking": "node scripts/testOrderPickingPickupFlow.js",
    "test": "npm run test:pickup-picking"
  },
  "dependencies": {
    "@prisma/client": "^5.7.0",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-validator": "^7.0.1",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "sharp": "^0.35.2",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "stripe": "^22.2.0",
    "twilio": "^6.0.2"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "prisma": "^5.7.0"
  },
  "prisma": {
    "seed": "src/seeders/regions.seed.js"
  }
}
