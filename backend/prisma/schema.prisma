generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// AUTH MODELS (Phase 1)
// ============================================================

model User {
  id            Int        @id @default(autoincrement())
  full_name     String
  email         String     @unique
  password_hash String
  phone         String?
  status        String     @default("active")
  created_at    DateTime   @default(now())
  updated_at    DateTime   @updatedAt
  user_roles    UserRole[]
  regions_created Region[] @relation("RegionCreatedBy")
  regions_updated Region[] @relation("RegionUpdatedBy")
  regions_deleted Region[] @relation("RegionDeletedBy")
  app_configs_updated AppConfig[] @relation("AppConfigUpdatedBy")
  packs_created              Pack[]
  flash_sales_created        FlashSale[]
  gamification_games_created GamificationGame[]
  referral_configs_created   ReferralConfig[]

  @@map("users")
}

model Role {
  id               Int              @id @default(autoincrement())
  name             String
  code             String           @unique
  description      String?
  status           String           @default("active")
  created_at       DateTime         @default(now())
  updated_at       DateTime         @updatedAt
  role_permissions RolePermission[]
  user_roles       UserRole[]

  @@map("roles")
}

model Permission {
  id               Int              @id @default(autoincrement())
  name             String
  code             String           @unique
  module           String
  description      String?
  created_at       DateTime         @default(now())
  updated_at       DateTime         @updatedAt
  role_permissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id            Int        @id @default(autoincrement())
  role_id       Int
  permission_id Int
  created_at    DateTime   @default(now())
  role          Role       @relation(fields: [role_id], references: [id], onDelete: Cascade)
  permission    Permission @relation(fields: [permission_id], references: [id], onDelete: Cascade)

  @@unique([role_id, permission_id])
  @@map("role_permissions")
}

model UserRole {
  id         Int      @id @default(autoincrement())
  user_id    Int
  role_id    Int
  created_at DateTime @default(now())
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [role_id], references: [id], onDelete: Cascade)

  @@unique([user_id, role_id])
  @@map("user_roles")
}

// ============================================================
// MASTER DATA CATALOGUE (Phase 2)
// ============================================================

model Family {
  id             Int         @id @default(autoincrement())
  name_fr        String
  name_ar        String
  code           String      @unique
  description_fr String?
  description_ar String?
  image_path     String?
  icon_path      String?
  status         String      @default("active")
  sort_order     Int         @default(0)
  created_at     DateTime    @default(now())
  updated_at     DateTime    @updatedAt
  deleted_at     DateTime?
  categories     Category[]
  articles       Article[]

  @@map("families")
}

model Category {
  id             Int           @id @default(autoincrement())
  family_id      Int
  name_fr        String
  name_ar        String
  code           String        @unique
  description_fr String?
  description_ar String?
  image_path     String?
  icon_path      String?
  status         String        @default("active")
  sort_order     Int           @default(0)
  created_at     DateTime      @default(now())
  updated_at     DateTime      @updatedAt
  deleted_at     DateTime?
  family         Family        @relation(fields: [family_id], references: [id])
  sub_categories SubCategory[]
  articles       Article[]

  @@map("categories")
}

model SubCategory {
  id             Int       @id @default(autoincrement())
  category_id    Int
  name_fr        String
  name_ar        String
  code           String    @unique
  description_fr String?
  description_ar String?
  image_path     String?
  icon_path      String?
  status         String    @default("active")
  sort_order     Int       @default(0)
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt
  deleted_at     DateTime?
  category       Category  @relation(fields: [category_id], references: [id])
  articles       Article[]

  @@map("sub_categories")
}

model Brand {
  id             Int       @id @default(autoincrement())
  name_fr        String
  name_ar        String
  code           String    @unique
  logo           String?
  description_fr String?
  description_ar String?
  status         String    @default("active")
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt
  deleted_at     DateTime?
  articles       Article[]

  @@map("brands")
}

model Unit {
  id                Int             @id @default(autoincrement())
  name_fr           String
  name_ar           String
  short_name_fr     String?
  short_name_ar     String?
  code              String          @unique
  status            String          @default("active")
  created_at        DateTime        @default(now())
  updated_at        DateTime        @updatedAt
  deleted_at        DateTime?
  packaging_types   PackagingType[]

  @@map("units")
}

model PackagingType {
  id         Int       @id @default(autoincrement())
  name_fr    String
  name_ar    String
  code       String    @unique
  quantity   Decimal?  @db.Decimal(10, 3)
  unit_id    Int?
  status     String    @default("active")
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?
  unit       Unit?     @relation(fields: [unit_id], references: [id])

  @@map("packaging_types")
}

model ConservationType {
  id              Int       @id @default(autoincrement())
  name_fr         String
  name_ar         String
  code            String    @unique
  min_temperature Decimal?  @db.Decimal(5, 2)
  max_temperature Decimal?  @db.Decimal(5, 2)
  status          String    @default("active")
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt
  deleted_at      DateTime?
  
  articles        Article[]

  @@map("conservation_types")
}

model ArticleType {
  id             Int       @id @default(autoincrement())
  name_fr        String
  name_ar        String
  code           String    @unique
  description_fr String?
  description_ar String?
  status         String    @default("active")
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt
  deleted_at     DateTime?
  
  articles       Article[]

  @@map("article_types")
}

model ArticleStatus {
  id         Int       @id @default(autoincrement())
  name_fr    String
  name_ar    String
  code       String    @unique
  color      String?
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  
  articles   Article[]

  @@map("article_statuses")
}

model Tax {
  id         Int       @id @default(autoincrement())
  name_fr    String
  name_ar    String
  code       String    @unique
  rate       Decimal   @db.Decimal(5, 2)
  status     String    @default("active")
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?
  
  articles   Article[]

  @@map("taxes")
}

model Article {
  id              Int          @id @default(autoincrement())
  sku_code        String       @unique @db.VarChar(100)
  ean13           String?      @unique @db.VarChar(13)
  name_fr         String       @db.VarChar(255)
  name_ar         String       @db.VarChar(255)
  description_fr  String?      @db.Text
  description_ar  String?      @db.Text
  brand_id              Int?
  family_id             Int
  sub_category_id       Int?
  category_id           Int?
  article_type_id       Int?
  article_status_id     Int?
  conservation_type_id  Int?
  tax_id                Int?
  unit_sale             String       @default("unit") @db.VarChar(20)
  unit_purchase         String       @default("unit") @db.VarChar(20)
  coeff                 Decimal      @default(1) @db.Decimal(10, 4)
  price                 Decimal      @db.Decimal(12, 2)
  vat_rate              Decimal      @default(20) @db.Decimal(5, 2)
  weight_g              Int?
  volume_ml             Int?
  is_active             Boolean      @default(true)
  is_deleted            Boolean      @default(false)
  deleted_at            DateTime?    @db.Timestamptz(6)
  created_at            DateTime     @default(now()) @db.Timestamptz(6)
  updated_at            DateTime     @updatedAt @db.Timestamptz(6)

  family              Family          @relation(fields: [family_id], references: [id])
  category            Category?       @relation(fields: [category_id], references: [id])
  sub_category        SubCategory?    @relation(fields: [sub_category_id], references: [id])
  brand               Brand?          @relation(fields: [brand_id], references: [id], onDelete: SetNull)
  article_type        ArticleType?    @relation(fields: [article_type_id], references: [id], onDelete: SetNull)
  article_status      ArticleStatus?  @relation(fields: [article_status_id], references: [id], onDelete: SetNull)
  conservation_type   ConservationType? @relation(fields: [conservation_type_id], references: [id], onDelete: SetNull)
  tax                 Tax?            @relation(fields: [tax_id], references: [id], onDelete: SetNull)
  images              ArticleImage[]

  // Lien optionnel vers skus (galerie sku_images)
  sku_uuid     String?      @unique @db.Uuid
  catalog_sku  Sku?         @relation("ArticleCatalogSku", fields: [sku_uuid], references: [id], onDelete: SetNull)

  @@map("articles")
}

// SKU logistique (UUID) — galerie sku_images
model Sku {
  id         String     @id @default(uuid()) @db.Uuid
  created_at DateTime   @default(now()) @db.Timestamptz(6)
  updated_at DateTime   @updatedAt @db.Timestamptz(6)
  images     SkuImage[]
  article    Article?   @relation("ArticleCatalogSku")
  stock_levels       StockLevel[]
  selling_rules      SellingRule[]
  reorder_rules      ReorderRule[]
  sku_node_locations SkuNodeLocation[]
  order_items        OrderItem[]
  pack_items         PackItem[]
  flash_sales        FlashSale[]
  stock_moves             StockMove[]
  stock_lots              StockLot[]
  gamification_prizes     GamificationPrize[]
  stock_threshold_rules   StockThresholdRule[]

  @@map("skus")
}

model SkuImage {
  id         String   @id @default(uuid()) @db.Uuid
  sku_id     String   @db.Uuid
  url        String   @db.Text
  alt_fr     String?  @db.VarChar(255)
  alt_ar     String?  @db.VarChar(255)
  is_primary Boolean  @default(false)
  sort_order Int      @default(0) @db.SmallInt
  created_at DateTime @default(now()) @db.Timestamptz(6)
  sku        Sku      @relation(fields: [sku_id], references: [id], onDelete: Cascade)

  @@map("sku_images")
}

model ArticleImage {
  id         Int       @id @default(autoincrement())
  article_id Int
  image_path String
  is_main    Boolean   @default(false)
  sort_order Int       @default(0)
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?
  article    Article   @relation(fields: [article_id], references: [id], onDelete: Cascade)

  @@map("article_images")
}

// ============================================================
// LOCATION & LOGISTICS NODES (Phase 3)
// ============================================================

model Region {
  id             String     @id @default(uuid()) @db.Uuid
  code           String     @unique
  name_fr        String
  name_ar        String
  description_fr String?
  description_ar String?
  is_active      Boolean    @default(true)
  is_deleted     Boolean    @default(false)
  created_at     DateTime   @default(now())
  updated_at     DateTime   @updatedAt
  deleted_at     DateTime?
  created_by     Int?
  updated_by     Int?
  deleted_by     Int?
  provinces      Province[]
  nodes          Node[]
  created_by_user User?     @relation("RegionCreatedBy", fields: [created_by], references: [id])
  updated_by_user User?     @relation("RegionUpdatedBy", fields: [updated_by], references: [id])
  deleted_by_user User?     @relation("RegionDeletedBy", fields: [deleted_by], references: [id])

  @@map("regions")
}

model Province {
  id         String   @id @default(uuid()) @db.Uuid
  region_id  String   @db.Uuid
  code       String   @unique
  name_fr    String
  name_ar    String
  is_active  Boolean  @default(true)
  is_deleted Boolean  @default(false)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  region     Region   @relation(fields: [region_id], references: [id])
  cities     City[]
  nodes      Node[]

  @@map("provinces")
}

model City {
  id          String   @id @default(uuid()) @db.Uuid
  province_id String   @db.Uuid
  code        String   @unique
  name_fr     String
  name_ar     String
  postal_code String?
  is_active   Boolean  @default(true)
  is_deleted  Boolean  @default(false)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  province    Province @relation(fields: [province_id], references: [id])
  nodes       Node[]

  @@map("cities")
}

model NodeType {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  name_fr     String
  name_ar     String
  description String?
  icon        String?
  color_badge String?
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  nodes       Node[]

  @@map("node_types")
}

model Node {
  id               String         @id @default(uuid()) @db.Uuid
  code             String         @unique
  name_fr          String
  name_ar          String
  node_type_id     String         @db.Uuid
  region_id        String         @db.Uuid
  province_id      String         @db.Uuid
  city_id          String         @db.Uuid
  address_line1    String?
  quartier         String?
  postal_code      String?
  lat              Decimal?       @db.Decimal(10, 7)
  lng              Decimal?       @db.Decimal(10, 7)
  phone            String?
  timezone         String         @default("Africa/Casablanca")
  delivery_radius_km Decimal?     @db.Decimal(8, 2)
  max_daily_orders Int?
  opening_hours_json Json?
  is_active        Boolean        @default(true)
  is_deleted       Boolean        @default(false)
  created_at       DateTime       @default(now())
  updated_at       DateTime       @updatedAt
  node_type        NodeType       @relation(fields: [node_type_id], references: [id])
  region           Region         @relation(fields: [region_id], references: [id])
  province         Province       @relation(fields: [province_id], references: [id])
  city             City           @relation(fields: [city_id], references: [id])
  delivery_slots   DeliverySlot[]
  stock_levels     StockLevel[]
  selling_rules    SellingRule[]
  reorder_rules    ReorderRule[]
  warehouse_locations WarehouseLocation[]
  sku_node_locations  SkuNodeLocation[]
  orders              Order[]
  order_items         OrderItem[]
  app_configs         AppConfig[]
  packs               Pack[]
  flash_sales         FlashSale[]
  points_rules        PointsRule[]
  gamification_games  GamificationGame[]
  stock_moves             StockMove[]
  stock_lots              StockLot[]
  tours                   Tour[]
  promotions              Promotion[]
  referral_configs        ReferralConfig[]
  stock_threshold_rules   StockThresholdRule[]

  @@map("nodes")
}

model DeliverySlot {
  id         String   @id @default(uuid()) @db.Uuid
  node_id    String   @db.Uuid
  name_fr    String
  name_ar    String
  day_of_week Int
  slot_start String
  slot_end   String
  max_orders Int?
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  node       Node     @relation(fields: [node_id], references: [id], onDelete: Cascade)
  orders_confirmed Order[] @relation("OrderConfirmedSlot")

  @@map("delivery_slots")
}

// ============================================================
// P0 CAHIER DES CHARGES — lookups + cœur commande / stock
// (coexiste avec auth User/Role Int — customers & admins UUID = phase ultérieure)
// ============================================================

model StockOperation {
  code    String @id @db.VarChar(10)
  name_fr String @db.VarChar(50)
  name_ar String @default("") @db.VarChar(50)

  @@map("stock_operations")
}

model MoveType {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique @db.VarChar(50)
  name_fr     String   @db.VarChar(100)
  name_ar     String   @db.VarChar(100)
  operation   String   @db.VarChar(10)
  color       String?  @db.VarChar(20)
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  stock_moves StockMove[]

  @@map("move_types")
}

model StockStatus {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique @db.VarChar(50)
  name_fr     String   @db.VarChar(100)
  name_ar     String   @db.VarChar(100)
  color       String?  @db.VarChar(20)
  is_sellable Boolean  @default(false)
  is_active   Boolean  @default(true)
  sort_order  Int      @default(0)
  created_at  DateTime @default(now()) @db.Timestamptz(6)

  @@map("stock_statuses")
}

model InventoryType {
  id             String   @id @default(uuid()) @db.Uuid
  code           String   @unique @db.VarChar(50)
  name_fr        String   @db.VarChar(100)
  name_ar        String   @db.VarChar(100)
  scope          String?  @db.VarChar(20)
  color          String?  @db.VarChar(20)
  description_fr String?  @db.VarChar(255)
  is_active      Boolean  @default(true)
  sort_order     Int      @default(0)
  created_at     DateTime @default(now()) @db.Timestamptz(6)

  @@map("inventory_types")
}

model InventoryStatus {
  id             String   @id @default(uuid()) @db.Uuid
  code           String   @unique @db.VarChar(50)
  name_fr        String   @db.VarChar(100)
  name_ar        String   @db.VarChar(100)
  color          String?  @db.VarChar(20)
  description_fr String?  @db.VarChar(255)
  is_active      Boolean  @default(true)
  sort_order     Int      @default(0)
  created_at     DateTime @default(now()) @db.Timestamptz(6)

  @@map("inventory_statuses")
}

model InventoryGapType {
  id                  String   @id @default(uuid()) @db.Uuid
  code                String   @unique @db.VarChar(50)
  name_fr             String   @db.VarChar(100)
  name_ar             String   @db.VarChar(100)
  description_fr      String?  @db.VarChar(255)
  color               String?  @db.VarChar(20)
  impact_stock        String   @db.VarChar(10)
  requires_validation Boolean  @default(false)
  is_active           Boolean  @default(true)
  sort_order          Int      @default(0)
  created_at          DateTime @default(now()) @db.Timestamptz(6)

  @@map("inventory_gap_types")
}

model StockThresholdRule {
  id                    String   @id @default(uuid()) @db.Uuid
  node_id               String   @db.Uuid
  sku_id                String   @db.Uuid
  stock_minimum         Decimal  @default(0) @db.Decimal(12, 3)
  stock_alert_threshold Decimal  @default(0) @db.Decimal(12, 3)
  stock_maximum         Decimal  @default(0) @db.Decimal(12, 3)
  reorder_quantity      Decimal  @default(0) @db.Decimal(12, 3)
  auto_restock_enabled  Boolean  @default(false)
  is_active             Boolean  @default(true)
  created_at            DateTime @default(now()) @db.Timestamptz(6)
  updated_at            DateTime @updatedAt @db.Timestamptz(6)

  node Node @relation(fields: [node_id], references: [id], onDelete: Cascade)
  sku  Sku  @relation(fields: [sku_id],  references: [id], onDelete: Cascade)

  @@unique([node_id, sku_id])
  @@map("stock_threshold_rules")
}

model OrderStatus {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique @db.VarChar(50)
  name_fr     String   @db.VarChar(100)
  name_ar     String   @db.VarChar(100)
  is_terminal Boolean  @default(false)
  sort_order  Int      @default(0) @db.SmallInt
  orders      Order[]

  @@map("order_statuses")
}

model OrderItemStatus {
  id          String      @id @default(uuid()) @db.Uuid
  code        String      @unique @db.VarChar(50)
  name_fr     String      @db.VarChar(100)
  name_ar     String      @db.VarChar(100)
  order_items OrderItem[]

  @@map("order_item_statuses")
}

model OrderSlotStatus {
  id     String @id @default(uuid()) @db.Uuid
  code   String @unique @db.VarChar(50)
  name_fr String @db.VarChar(100)
  name_ar String @db.VarChar(100)

  @@map("order_slot_statuses")
}

model PaymentStatus {
  id        String    @id @default(uuid()) @db.Uuid
  code      String    @unique @db.VarChar(50)
  name_fr   String    @db.VarChar(100)
  name_ar   String    @db.VarChar(100)
  payments  Payment[]

  @@map("payment_statuses")
}

model PaymentMethod {
  id        String    @id @default(uuid()) @db.Uuid
  code      String    @unique @db.VarChar(50)
  name_fr   String    @db.VarChar(100)
  name_ar   String    @db.VarChar(100)
  is_active Boolean   @default(true)
  payments  Payment[]

  @@map("payment_methods")
}

model TourStatus {
  id      String @id @default(uuid()) @db.Uuid
  code    String @unique @db.VarChar(50)
  name_fr String @db.VarChar(100)
  name_ar String @db.VarChar(100)
  tours   Tour[]

  @@map("tour_statuses")
}

model StopStatus {
  id         String     @id @default(uuid()) @db.Uuid
  code       String     @unique @db.VarChar(50)
  name_fr    String     @db.VarChar(100)
  name_ar    String     @db.VarChar(100)
  tour_stops TourStop[]

  @@map("stop_statuses")
}

model PickingStatus {
  id      String @id @default(uuid()) @db.Uuid
  code    String @unique @db.VarChar(50)
  name_fr String @db.VarChar(100)
  name_ar String @db.VarChar(100)

  @@map("picking_statuses")
}

model PickItemStatus {
  id      String @id @default(uuid()) @db.Uuid
  code    String @unique @db.VarChar(50)
  name_fr String @db.VarChar(100)
  name_ar String @db.VarChar(100)

  @@map("pick_item_statuses")
}

model ReferralStatus {
  id         String     @id @default(uuid()) @db.Uuid
  code       String     @unique @db.VarChar(50)
  name_fr    String     @db.VarChar(100)
  name_ar    String     @db.VarChar(100)
  referrals  Referral[]

  @@map("referral_statuses")
}

model WalletTxnType {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique @db.VarChar(50)
  name_fr   String   @db.VarChar(100)
  name_ar   String   @db.VarChar(100)
  direction String   @db.VarChar(10)

  @@map("wallet_txn_types")
}

model PrizeType {
  id                 String               @id @default(uuid()) @db.Uuid
  code               String               @unique @db.VarChar(50)
  name_fr            String               @db.VarChar(100)
  name_ar            String               @db.VarChar(100)
  gamification_prizes GamificationPrize[]

  @@map("prize_types")
}

model GameType {
  id                String              @id @default(uuid()) @db.Uuid
  code              String              @unique @db.VarChar(50)
  name_fr           String              @db.VarChar(100)
  name_ar           String              @db.VarChar(100)
  gamification_games GamificationGame[]

  @@map("game_types")
}

model GamePlayPeriod {
  id                 String             @id @default(uuid()) @db.Uuid
  code               String             @unique @db.VarChar(50)
  name_fr            String             @db.VarChar(100)
  name_ar            String             @db.VarChar(100)
  gamification_games GamificationGame[]

  @@map("game_play_periods")
}

model UnlockCondition {
  id                 String             @id @default(uuid()) @db.Uuid
  code               String             @unique @db.VarChar(50)
  name_fr            String             @db.VarChar(100)
  name_ar            String             @db.VarChar(100)
  gamification_games GamificationGame[]

  @@map("unlock_conditions")
}

model PromoType {
  id           String       @id @default(uuid()) @db.Uuid
  code         String       @unique @db.VarChar(50)
  name_fr      String       @db.VarChar(100)
  name_ar      String       @db.VarChar(100)
  promotions   Promotion[]

  @@map("promo_types")
}

model PointsRuleType {
