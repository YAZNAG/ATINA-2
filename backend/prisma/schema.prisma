generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                         Int                   @id @default(autoincrement())
  full_name                  String
  email                      String                @unique
  password_hash              String
  phone                      String?
  status                     String                @default("active")
  created_at                 DateTime              @default(now())
  updated_at                 DateTime              @updatedAt
  deleted_at                 DateTime?             @db.Timestamptz(6)
  is_active                  Boolean               @default(true)
  is_deleted                 Boolean               @default(false)
  last_login_at              DateTime?             @db.Timestamptz(6)
  otp_code                   String?               @db.VarChar(10)
  otp_expires_at             DateTime?             @db.Timestamptz(6)
  phone_country              String?               @default("+212") @db.VarChar(5)
  phone_number               String?               @db.VarChar(15)
  phone_verified_at          DateTime?             @db.Timestamptz(6)
  app_configs_updated        AppConfig[]           @relation("AppConfigUpdatedBy")
  backoffice_admin           BackofficeAdmin?
  customer                   Customer?
  flash_sales_created        FlashSale[]
  gamification_games_created GamificationGame[]
  packs_created              Pack[]
  referral_configs_created   ReferralConfig[]
  regions_created            Region[]              @relation("RegionCreatedBy")
  regions_deleted            Region[]              @relation("RegionDeletedBy")
  regions_updated            Region[]              @relation("RegionUpdatedBy")
  assigned_conversations     SupportConversation[] @relation("SupportAgentConversations")
  user_roles                 UserRole[]
  stock_moves_operated       StockMove[]           @relation("StockMoveOperator")

  @@map("users")
}

model Role {
  id               Int              @id @default(autoincrement())
  name             String
  code             String           @unique
  description      String?
  status           String           @default("active")
  created_at       DateTime         @default(now())
  updated_at       DateTime         @updatedAt
  is_active        Boolean          @default(true)
  is_system        Boolean          @default(false)
  name_ar          String?          @db.VarChar(100)
  name_fr          String?          @db.VarChar(100)
  role_permissions RolePermission[]
  user_roles       UserRole[]

  @@map("roles")
}

model Permission {
  id               Int              @id @default(autoincrement())
  name             String
  code             String           @unique
  module           String
  description      String?
  created_at       DateTime         @default(now())
  updated_at       DateTime         @updatedAt
  action           String?          @db.VarChar(50)
  name_ar          String?          @db.VarChar(150)
  name_fr          String?          @db.VarChar(150)
  role_permissions RolePermission[]

  @@map("permissions")
}

model BackofficeAdmin {
  id         Int      @id @default(autoincrement())
  user_id    Int      @unique
  node_id    String?  @db.Uuid
  created_by Int?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("backoffice_admins")
}

model Picker {
  id            String           @id @default(uuid()) @db.Uuid
  node_id       String           @db.Uuid
  phone_country String           @default("+212") @db.VarChar(5)
  phone_number  String           @db.VarChar(15)
  name          String           @db.VarChar(150)
  password_hash String
  is_active     Boolean          @default(true)
  is_deleted    Boolean          @default(false)
  deleted_at    DateTime?        @db.Timestamptz(6)
  created_by    Int?
  created_at    DateTime         @default(now()) @db.Timestamptz(6)
  updated_at    DateTime         @updatedAt @db.Timestamptz(6)
  avatar_url    String?
  email         String?          @db.VarChar(255)
  node          Node             @relation(fields: [node_id], references: [id])
  sessions      PickingSession[]

  @@map("pickers")
}

model PickingSession {
  id           String               @id @default(uuid()) @db.Uuid
  order_id     String               @db.Uuid
  node_id      String               @db.Uuid
  picker_id    String?              @db.Uuid
  status_id    String               @db.Uuid
  started_at   DateTime?            @db.Timestamptz(6)
  completed_at DateTime?            @db.Timestamptz(6)
  error_count  Int                  @default(0) @db.SmallInt
  created_at   DateTime             @default(now()) @db.Timestamptz(6)
  items        PickingSessionItem[]
  node         Node                 @relation("NodePickingSessions", fields: [node_id], references: [id])
  order        Order                @relation(fields: [order_id], references: [id])
  picker       Picker?              @relation(fields: [picker_id], references: [id])
  status       PickingStatus        @relation(fields: [status_id], references: [id])

  @@map("picking_sessions")
}

model PickingSessionItem {
  id                String             @id @default(uuid()) @db.Uuid
  session_id        String             @db.Uuid
  order_item_id     String             @db.Uuid
  location_id       String?            @db.Uuid
  status_id         String             @db.Uuid
  qty_expected      Decimal            @db.Decimal(10, 3)
  qty_picked        Decimal            @default(0) @db.Decimal(10, 3)
  scanned_ean       String?            @db.VarChar(13)
  substitute_sku_id String?            @db.Uuid
  picked_at         DateTime?          @db.Timestamptz(6)
  location          WarehouseLocation? @relation(fields: [location_id], references: [id])
  order_item        OrderItem          @relation(fields: [order_item_id], references: [id], onDelete: Cascade)
  session           PickingSession     @relation(fields: [session_id], references: [id], onDelete: Cascade)
  status            PickItemStatus     @relation(fields: [status_id], references: [id])
  substitute_sku    Sku?               @relation("PickingSubstituteSku", fields: [substitute_sku_id], references: [id])

  @@map("picking_session_items")
}

model Driver {
  id            String    @id @default(uuid()) @db.Uuid
  node_id       String    @db.Uuid
  phone_country String    @default("+212") @db.VarChar(5)
  phone_number  String    @db.VarChar(15)
  name          String    @db.VarChar(150)
  password_hash String
  vehicle_type  String?   @db.VarChar(50)
  vehicle_plate String?   @db.VarChar(20)
  is_active     Boolean   @default(true)
  is_deleted    Boolean   @default(false)
  deleted_at    DateTime? @db.Timestamptz(6)
  created_by    Int?
  created_at    DateTime  @default(now()) @db.Timestamptz(6)
  updated_at    DateTime  @updatedAt @db.Timestamptz(6)
  node          Node      @relation(fields: [node_id], references: [id])
  tours         Tour[]    @relation("DriverTours")

  @@map("drivers")
}

model RolePermission {
  id            Int        @id @default(autoincrement())
  role_id       Int
  permission_id Int
  created_at    DateTime   @default(now())
  permission    Permission @relation(fields: [permission_id], references: [id], onDelete: Cascade)
  role          Role       @relation(fields: [role_id], references: [id], onDelete: Cascade)

  @@unique([role_id, permission_id])
  @@map("role_permissions")
}

model UserRole {
  id         Int      @id @default(autoincrement())
  user_id    Int
  role_id    Int
  created_at DateTime @default(now())
  role       Role     @relation(fields: [role_id], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, role_id])
  @@map("user_roles")
}

model SkuFamily {
  id          String         @id @default(uuid()) @db.Uuid
  code        String         @unique @db.VarChar(50)
  name_fr     String         @db.VarChar(150)
  name_ar     String         @db.VarChar(150)
  is_deleted  Boolean        @default(false)
  deleted_at  DateTime?
  created_at  DateTime       @default(now())
  updated_at  DateTime       @default(now())
  is_active   Boolean        @default(true)
  sort_order  Int            @default(0) @db.SmallInt
  subfamilies SkuSubFamily[]
  skus        Sku[]

  @@map("sku_families")
}

model SkuSubFamily {
  id         String    @id @default(uuid()) @db.Uuid
  code       String    @unique @db.VarChar(50)
  name_fr    String    @db.VarChar(150)
  name_ar    String    @db.VarChar(150)
  family_id  String    @db.Uuid
  is_deleted Boolean   @default(false)
  deleted_at DateTime?
  created_at DateTime  @default(now())
  updated_at DateTime  @default(now())
  is_active  Boolean   @default(true)
  sort_order Int       @default(0) @db.SmallInt
  family     SkuFamily @relation(fields: [family_id], references: [id])
  skus       Sku[]

  @@map("sku_subfamilies")
}

model Category {
  name_fr      String       @db.VarChar(150)
  name_ar      String       @db.VarChar(150)
  code         String       @unique @db.VarChar(50)
  sort_order   Int          @default(0) @db.SmallInt
  created_at   DateTime     @default(now())
  updated_at   DateTime     @default(now())
  deleted_at   DateTime?
  gpc_code     String?      @db.VarChar(20)
  image_url    String?
  is_active    Boolean      @default(true)
  is_deleted   Boolean      @default(false)
  id           String       @id @default(uuid()) @db.Uuid
  flash_sales  FlashSale[]
  points_rules PointsRule[]
  skus         Sku[]

  @@map("categories")
}

model Brand {
  id             Int         @id @default(autoincrement())
  name_fr        String
  name_ar        String
  code           String      @unique
  logo           String?
  status         String      @default("active")
  created_at     DateTime    @default(now())
  updated_at     DateTime    @updatedAt
  deleted_at     DateTime?
  description_ar String?
  description_fr String?
  flash_sales    FlashSale[]
  skus           Sku[]

  @@map("brands")
}

model Unit {
  id              Int             @id @default(autoincrement())
  name_fr         String
  name_ar         String
  short_name_fr   String?
  short_name_ar   String?
  code            String          @unique
  status          String          @default("active")
  created_at      DateTime        @default(now())
  updated_at      DateTime        @updatedAt
  deleted_at      DateTime?
  sort_order      Int             @default(0)
  packaging_types PackagingType[]
  skus_purchase   Sku[]           @relation("SkuUnitPurchase")
  skus_sale       Sku[]           @relation("SkuUnitSale")

  @@map("units")
}

model PackagingType {
  id         Int       @id @default(autoincrement())
  name_fr    String
  name_ar    String
  code       String    @unique
  quantity   Decimal?  @db.Decimal(10, 3)
  unit_id    Int?
  status     String    @default("active")
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?
  unit       Unit?     @relation(fields: [unit_id], references: [id])
  skus       Sku[]

  @@map("packaging_types")
}

model ConservationType {
  id              Int       @id @default(autoincrement())
  name_fr         String
  name_ar         String
  code            String    @unique
  min_temperature Decimal?  @db.Decimal(5, 2)
  max_temperature Decimal?  @db.Decimal(5, 2)
  status          String    @default("active")
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt
  deleted_at      DateTime?
  skus            Sku[]

  @@map("conservation_types")
}

model Tax {
  id         Int       @id @default(autoincrement())
  name_fr    String
  name_ar    String
  code       String    @unique
  rate       Decimal   @db.Decimal(5, 2)
  status     String    @default("active")
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?
  skus       Sku[]

  @@map("taxes")
}

model Sku {
  id                         String               @id @default(uuid()) @db.Uuid
  created_at                 DateTime             @default(now()) @db.Timestamptz(6)
  updated_at                 DateTime             @updatedAt @db.Timestamptz(6)
  brand_id                   Int?
  category_id                String?              @db.Uuid
  coeff                      Decimal              @default(1) @db.Decimal(10, 4)
  conservation_type_id       Int?
  deleted_at                 DateTime?            @db.Timestamptz(6)
  description_ar             String?
  description_fr             String?
  ean13                      String?              @unique @db.VarChar(13)
  is_active                  Boolean              @default(true)
  is_deleted                 Boolean              @default(false)
  name_ar                    String               @db.VarChar(255)
  name_fr                    String               @db.VarChar(255)
  packaging_type_id          Int?
  price                      Decimal              @db.Decimal(12, 2)
  sku_code                   String               @unique @db.VarChar(100)
  sku_family_id              String               @db.Uuid
  sku_subfamily_id           String?              @db.Uuid
  status                     String               @default("active") @db.VarChar(20)
  tax_id                     Int?
  unit_purchase              String               @default("unit") @db.VarChar(20)
  unit_purchase_id           Int?
  unit_sale                  String               @default("unit") @db.VarChar(20)
  unit_sale_id               Int?
  vat_rate                   Decimal              @default(20) @db.Decimal(5, 2)
  volume_ml                  Int?
  weight_g                   Int?
  reviews                    ArticleReview[]
  cart_items                 CartItem[]
  flash_sales                FlashSale[]
  gamification_prizes        GamificationPrize[]
  order_items                OrderItem[]
  pack_items                 PackItem[]
  substitution_picking_items PickingSessionItem[] @relation("PickingSubstituteSku")
  reorder_rules              ReorderRule[]
  selling_rules              SellingRule[]
  images                     SkuImage[]
  sku_node_locations         SkuNodeLocation[]
  brand                      Brand?               @relation(fields: [brand_id], references: [id])
  category                   Category?            @relation(fields: [category_id], references: [id])
  conservation_type          ConservationType?    @relation(fields: [conservation_type_id], references: [id])
  packaging_type             PackagingType?       @relation(fields: [packaging_type_id], references: [id])
  sku_family                 SkuFamily            @relation(fields: [sku_family_id], references: [id])
  sku_subfamily              SkuSubFamily?        @relation(fields: [sku_subfamily_id], references: [id])
  tax                        Tax?                 @relation(fields: [tax_id], references: [id])
  unit_purchase_ref          Unit?                @relation("SkuUnitPurchase", fields: [unit_purchase_id], references: [id])
  unit_sale_ref              Unit?                @relation("SkuUnitSale", fields: [unit_sale_id], references: [id])
  stock_levels               StockLevel[]
  stock_lots                 StockLot[]
  stock_moves                StockMove[]
  stock_threshold_rules      StockThresholdRule[]
  wishlist_items             Wishlist[]

  @@map("skus")
}

model SkuImage {
  id         String    @id @default(uuid()) @db.Uuid
  sku_id     String    @db.Uuid
  url        String
  alt_fr     String?   @db.VarChar(255)
  alt_ar     String?   @db.VarChar(255)
  is_primary Boolean   @default(false)
  sort_order Int       @default(0) @db.SmallInt
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  deleted_at DateTime?
  updated_at DateTime  @updatedAt @db.Timestamptz(6)
  sku        Sku       @relation(fields: [sku_id], references: [id], onDelete: Cascade)

  @@map("sku_images")
}

model Region {
  id              String    @id @default(uuid()) @db.Uuid
  code            String    @unique
  name_fr         String
  name_ar         String
  description_fr  String?
  description_ar  String?
  is_active       Boolean   @default(true)
  is_deleted      Boolean   @default(false)
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt
  created_by      Int?
  deleted_at      DateTime?
  deleted_by      Int?
  updated_by      Int?
  cities          City[]
  nodes           Node[]
  created_by_user User?     @relation("RegionCreatedBy", fields: [created_by], references: [id])
  deleted_by_user User?     @relation("RegionDeletedBy", fields: [deleted_by], references: [id])
  updated_by_user User?     @relation("RegionUpdatedBy", fields: [updated_by], references: [id])

  @@map("regions")
}

model City {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  name_fr     String
  name_ar     String
  postal_code String?
  is_active   Boolean  @default(true)
  is_deleted  Boolean  @default(false)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  region_id   String   @db.Uuid
  region      Region   @relation(fields: [region_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  nodes       Node[]

  @@map("cities")
}

model NodeType {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  name_fr     String
  name_ar     String
  created_at  DateTime @default(now())
  color_badge String?
  description String?
  icon        String?
  is_active   Boolean  @default(true)
  nodes       Node[]

  @@map("node_types")
}

model Node {
  id                    String               @id @default(uuid()) @db.Uuid
  code                  String               @unique
  name_fr               String
  name_ar               String
  node_type_id          String               @db.Uuid
  region_id             String               @db.Uuid
  city_id               String               @db.Uuid
  address_line1         String?
  quartier              String?
  postal_code           String?
  lat                   Decimal?             @db.Decimal(10, 7)
  lng                   Decimal?             @db.Decimal(10, 7)
  phone                 String?
  timezone              String               @default("Africa/Casablanca")
  delivery_radius_km    Decimal?             @db.Decimal(8, 2)
  max_daily_orders      Int?
  opening_hours_json    Json?
  is_active             Boolean              @default(true)
  is_deleted            Boolean              @default(false)
  created_at            DateTime             @default(now())
  updated_at            DateTime             @updatedAt
  app_configs           AppConfig[]
  delivery_slots        DeliverySlot[]
  drivers               Driver[]
  flash_sales           FlashSale[]
  gamification_games    GamificationGame[]
  warehouse_locations   WarehouseLocation[]
  city                  City                 @relation(fields: [city_id], references: [id])
  node_type             NodeType             @relation(fields: [node_type_id], references: [id])
  region                Region               @relation(fields: [region_id], references: [id])
  order_items           OrderItem[]
  orders                Order[]
  packs                 Pack[]
  pickers               Picker[]
  picking_sessions      PickingSession[]     @relation("NodePickingSessions")
  points_rules          PointsRule[]
  promotions            Promotion[]
  referral_configs      ReferralConfig[]
  reorder_rules         ReorderRule[]
  selling_rules         SellingRule[]
  sku_node_locations    SkuNodeLocation[]
  stock_levels          StockLevel[]
  stock_lots            StockLot[]
  stock_moves           StockMove[]
  stock_threshold_rules StockThresholdRule[]
  tours                 Tour[]

  @@map("nodes")
}

model DeliverySlot {
  id               String    @id @default(uuid()) @db.Uuid
  node_id          String    @db.Uuid
  specific_date    DateTime  @db.Date
  slot_start       String
  slot_end         String
  max_orders       Int
  is_active        Boolean   @default(true)
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt
  node             Node      @relation(fields: [node_id], references: [id], onDelete: Cascade)
  orders_confirmed Order[]   @relation("OrderConfirmedSlot")

  @@index([node_id, specific_date])
  @@map("delivery_slots")
}


model StockOperation {
  code    String @id @db.VarChar(10)
  name_fr String @db.VarChar(50)
  name_ar String @default("") @db.VarChar(50)

  @@map("stock_operations")
}

model MoveType {
  id          String      @id @default(uuid()) @db.Uuid
  code        String      @unique @db.VarChar(50)
  name_fr     String      @db.VarChar(100)
  name_ar     String      @db.VarChar(100)
  operation   String      @db.VarChar(10)
  created_at  DateTime    @default(now()) @db.Timestamptz(6)
  color       String?     @db.VarChar(20)
  stock_moves StockMove[]

  @@map("move_types")
}

model StockStatus {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique @db.VarChar(50)
  name_fr     String   @db.VarChar(100)
  name_ar     String   @db.VarChar(100)
  color       String?  @db.VarChar(20)
  is_sellable Boolean  @default(false)
  is_active   Boolean  @default(true)
  sort_order  Int      @default(0)
  created_at  DateTime @default(now()) @db.Timestamptz(6)

  @@map("stock_statuses")
}

model InventoryType {
  id             String   @id @default(uuid()) @db.Uuid
  code           String   @unique @db.VarChar(50)
  name_fr        String   @db.VarChar(100)
  name_ar        String   @db.VarChar(100)
  scope          String?  @db.VarChar(20)
  color          String?  @db.VarChar(20)
  description_fr String?  @db.VarChar(255)
  is_active      Boolean  @default(true)
  sort_order     Int      @default(0)
  created_at     DateTime @default(now()) @db.Timestamptz(6)

  @@map("inventory_types")
}

model InventoryStatus {
  id             String   @id @default(uuid()) @db.Uuid
  code           String   @unique @db.VarChar(50)
  name_fr        String   @db.VarChar(100)
  name_ar        String   @db.VarChar(100)
  color          String?  @db.VarChar(20)
  description_fr String?  @db.VarChar(255)
  is_active      Boolean  @default(true)
  sort_order     Int      @default(0)
  created_at     DateTime @default(now()) @db.Timestamptz(6)

  @@map("inventory_statuses")
}

model InventoryGapType {
  id                  String   @id @default(uuid()) @db.Uuid
  code                String   @unique @db.VarChar(50)
  name_fr             String   @db.VarChar(100)
  name_ar             String   @db.VarChar(100)
  description_fr      String?  @db.VarChar(255)
  color               String?  @db.VarChar(20)
  impact_stock        String   @db.VarChar(10)
  requires_validation Boolean  @default(false)
  is_active           Boolean  @default(true)
  sort_order          Int      @default(0)
  created_at          DateTime @default(now()) @db.Timestamptz(6)

  @@map("inventory_gap_types")
}

model StockThresholdRule {
  id                    String   @id @default(uuid()) @db.Uuid
  node_id               String   @db.Uuid
  sku_id                String   @db.Uuid
  stock_minimum         Decimal  @default(0) @db.Decimal(12, 3)
  stock_alert_threshold Decimal  @default(0) @db.Decimal(12, 3)
  stock_maximum         Decimal  @default(0) @db.Decimal(12, 3)
  reorder_quantity      Decimal  @default(0) @db.Decimal(12, 3)
  auto_restock_enabled  Boolean  @default(false)
  is_active             Boolean  @default(true)
  created_at            DateTime @default(now()) @db.Timestamptz(6)
  updated_at            DateTime @updatedAt @db.Timestamptz(6)
  node                  Node     @relation(fields: [node_id], references: [id], onDelete: Cascade)
  sku                   Sku      @relation(fields: [sku_id], references: [id], onDelete: Cascade)

  @@unique([node_id, sku_id])
  @@map("stock_threshold_rules")
}

model OrderStatus {
  id          String         @id @default(uuid()) @db.Uuid
  code        String         @unique @db.VarChar(50)
  name_fr     String         @db.VarChar(100)
  name_ar     String         @db.VarChar(100)
  is_terminal Boolean        @default(false)
  sort_order  Int            @default(0) @db.SmallInt
  color       String         @default("gray") @db.VarChar(20)
  histories   OrderHistory[]
  orders      Order[]

  @@map("order_statuses")
}

model OrderItemStatus {
  id          String      @id @default(uuid()) @db.Uuid
  code        String      @unique @db.VarChar(50)
  name_fr     String      @db.VarChar(100)
  name_ar     String      @db.VarChar(100)
  color       String      @default("gray") @db.VarChar(20)
  order_items OrderItem[]

  @@map("order_item_statuses")
}

model OrderSlotStatus {
  id      String @id @default(uuid()) @db.Uuid
  code    String @unique @db.VarChar(50)
  name_fr String @db.VarChar(100)
  name_ar String @db.VarChar(100)
  color   String @default("gray") @db.VarChar(20)

  @@map("order_slot_statuses")
}

model PaymentStatus {
  id       String    @id @default(uuid()) @db.Uuid
  code     String    @unique @db.VarChar(50)
  name_fr  String    @db.VarChar(100)
