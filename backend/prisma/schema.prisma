model Customer {
  id                    String                @id @default(uuid()) @db.Uuid
  phone_country         String                @default("+212") @db.VarChar(5)
  phone_number          String                @db.VarChar(15)
  phone_verified_at     DateTime?             @db.Timestamptz(6)
  name                  String                @db.VarChar(150)
  preferred_lang        String                @default("fr") @db.VarChar(5)
  referral_code         String                @unique @db.VarChar(20)
  referred_by_id        String?               @db.Uuid
  wallet_balance        Decimal               @default(0) @db.Decimal(12, 2)
  points_balance        Int                   @default(0)
  points_lifetime       Int                   @default(0)
  city                  String?               @db.VarChar(100)
  lat                   Decimal?              @db.Decimal(9, 6)
  lng                   Decimal?              @db.Decimal(9, 6)
  is_active             Boolean               @default(true)
  is_deleted            Boolean               @default(false)
  deleted_at            DateTime?             @db.Timestamptz(6)
  created_at            DateTime              @default(now()) @db.Timestamptz(6)
  updated_at            DateTime              @updatedAt @db.Timestamptz(6)
  user_id               Int?                  @unique
  avatar_url            String?               @db.VarChar(500)
  addresses             Address[]
  reviews               ArticleReview[]
  cart                  Cart?
  claims                Claim[]
  coupon_redemptions    CouponRedemption[]
  referred_by           Customer?             @relation("CustomerReferrals", fields: [referred_by_id], references: [id])
  referrals             Customer[]            @relation("CustomerReferrals")
  user                  User?                 @relation(fields: [user_id], references: [id])
  gamification_plays    GamificationPlay[]
  notifications         Notification[]
  orders                Order[]
  points_transactions   PointsTransaction[]
  promotions            Promotion[]
  referrals_as_referee  Referral[]            @relation("ReferralReferee")
  referrals_as_referrer Referral[]            @relation("ReferralReferrer")
  support_conversations SupportConversation[]
  wallet_transactions   WalletTransaction[]
  wishlist_items        Wishlist[]

  @@map("customers")
}

