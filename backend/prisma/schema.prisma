  MISSING_PRODUCT
  DAMAGED_PRODUCT
  WRONG_PRODUCT
  REFUND_REQUEST
  DELIVERY_ISSUE
  OTHER
}

enum ClaimStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum ClaimPriority {
  NORMAL
  URGENT
}
