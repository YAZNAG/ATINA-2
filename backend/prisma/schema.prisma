  play_period_id        String    @db.Uuid
  unlock_condition_id   String?   @db.Uuid
  name_fr               String    @db.VarChar(255)
  name_ar               String    @db.VarChar(255)
  max_plays_per_user    Int       @default(1) @db.SmallInt
  unlock_min_amount     Decimal?  @db.Decimal(12, 2)
  starts_at             DateTime  @db.Timestamptz(6)
  ends_at               DateTime? @db.Timestamptz(6)
  is_active             Boolean   @default(true)
  is_deleted            Boolean   @default(false)
  deleted_at            DateTime? @db.Timestamptz(6)
  created_by            Int
  created_at            DateTime  @default(now()) @db.Timestamptz(6)
  updated_at            DateTime  @updatedAt @db.Timestamptz(6)

  node              Node?             @relation(fields: [node_id], references: [id])
  game_type         GameType          @relation(fields: [game_type_id], references: [id])
  play_period       GamePlayPeriod    @relation(fields: [play_period_id], references: [id])
  unlock_condition  UnlockCondition?  @relation(fields: [unlock_condition_id], references: [id])
  creator             User              @relation(fields: [created_by], references: [id])
  prizes              GamificationPrize[]
  plays               GamificationPlay[]

  @@map("gamification_games")
}

model GamificationPrize {
  id                   String   @id @default(uuid()) @db.Uuid
  game_id              String   @db.Uuid
  prize_type_id        String   @db.Uuid
  name_fr              String   @db.VarChar(150)
  name_ar              String   @db.VarChar(150)
  value                Decimal? @db.Decimal(12, 2)
  sku_id               String?  @db.Uuid
  coupon_code_prefix   String?  @db.VarChar(20)
  probability_weight   Decimal  @db.Decimal(8, 4)
  stock_limit          Int?
  awarded_count        Int      @default(0)
  sort_order           Int      @default(0) @db.SmallInt
  is_active            Boolean  @default(true)

  game       GamificationGame @relation(fields: [game_id], references: [id], onDelete: Cascade)
  prize_type PrizeType        @relation(fields: [prize_type_id], references: [id])
  sku        Sku?             @relation(fields: [sku_id], references: [id])
  plays      GamificationPlay[]

  @@map("gamification_prizes")
}

model GamificationPlay {
  id         String    @id @default(uuid()) @db.Uuid
  customer_id String   @db.Uuid
  game_id    String    @db.Uuid
  prize_id   String?   @db.Uuid
  order_id   String?   @db.Uuid
  result     String    @db.VarChar(10)
  played_at  DateTime  @default(now()) @db.Timestamptz(6)
  claimed_at DateTime? @db.Timestamptz(6)
  expires_at DateTime? @db.Timestamptz(6)

  customer Customer            @relation(fields: [customer_id], references: [id])
  game     GamificationGame    @relation(fields: [game_id], references: [id])
  prize    GamificationPrize?  @relation(fields: [prize_id], references: [id])
  order    Order?              @relation("GamificationPlayOrder", fields: [order_id], references: [id])

  @@map("gamification_plays")
}

model StockMove {
  id           String   @id @default(uuid()) @db.Uuid
  node_id      String   @db.Uuid
  sku_id       String   @db.Uuid
  move_type_id String?  @db.Uuid
  lot_id       String?  @db.Uuid
  order_id     String?  @db.Uuid
  operator_id  String?  @db.Uuid
  qty_delta    Decimal  @db.Decimal(12, 3)
  reference    String?  @db.VarChar(100)
  reason       String?  @db.Text
  metadata     Json?
  created_at   DateTime @default(now()) @db.Timestamptz(6)

  node      Node       @relation(fields: [node_id], references: [id], onDelete: Cascade)
  sku       Sku        @relation(fields: [sku_id], references: [id], onDelete: Cascade)
  move_type MoveType?  @relation(fields: [move_type_id], references: [id])
  lot       StockLot?  @relation(fields: [lot_id], references: [id])
  order     Order?     @relation(fields: [order_id], references: [id])

  @@map("stock_moves")
}

model StockLot {
  id            String    @id @default(uuid()) @db.Uuid
  sku_id        String    @db.Uuid
  node_id       String    @db.Uuid
  qty_initial   Decimal   @db.Decimal(12, 3)
  qty_remaining Decimal   @db.Decimal(12, 3)
  cost_unit     Decimal   @default(0) @db.Decimal(12, 4)
  lot_number    String?   @db.VarChar(100)
  received_at   DateTime  @default(now()) @db.Timestamptz(6)
  expiry_date   DateTime? @db.Date
  is_deleted    Boolean   @default(false)
  deleted_at    DateTime? @db.Timestamptz(6)
  created_at    DateTime  @default(now()) @db.Timestamptz(6)

  node        Node        @relation(fields: [node_id], references: [id], onDelete: Cascade)
  sku         Sku         @relation(fields: [sku_id], references: [id], onDelete: Cascade)
  stock_moves StockMove[]

  @@map("stock_lots")
}

model Tour {
  id         String    @id @default(uuid()) @db.Uuid
  node_id    String?   @db.Uuid
  status_id  String    @db.Uuid
  planned_at DateTime? @db.Timestamptz(6)
  notes      String?   @db.Text
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  updated_at DateTime  @updatedAt @db.Timestamptz(6)

  node   Node?      @relation(fields: [node_id], references: [id])
  status TourStatus @relation(fields: [status_id], references: [id])
  stops  TourStop[]
  orders Order[]

  @@map("tours")
}

model TourStop {
  id         String   @id @default(uuid()) @db.Uuid
  tour_id    String   @db.Uuid
  order_id   String?  @db.Uuid
  status_id  String   @db.Uuid
  sort_order Int      @default(0) @db.SmallInt
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @updatedAt @db.Timestamptz(6)

  tour   Tour       @relation(fields: [tour_id], references: [id], onDelete: Cascade)
  order  Order?     @relation(fields: [order_id], references: [id])
  status StopStatus @relation(fields: [status_id], references: [id])

  @@map("tour_stops")
}
